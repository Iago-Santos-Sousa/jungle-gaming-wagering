# Aplicação
NODE_ENV=development
PORT=3000
API_HOST_PORT=3000
LOG_LEVEL=info
# Liga os workers (consumer SQS, publisher da outbox e reprocessador de referências pendentes)
WORKERS_ENABLED=true
# Quantidade de réplicas extras do serviço wagering-worker no docker compose
WORKER_REPLICAS=2
SHUTDOWN_TIMEOUT_MS=20000

# PostgreSQL (DB_HOST=localhost para rodar a API fora do Docker; no compose o host é o serviço wagering-postgres)
DB_HOST=localhost
DB_PORT=5432
POSTGRES_HOST_PORT=5432
DB_NAME=wagering
DB_USER=wagering
DB_PASSWORD=wagering
DB_POOL_MAX=10
DB_POOL_ACQUIRE_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_TIMEZONE=America/Sao_Paulo

# SQS (MiniStack local; no compose o endpoint é http://wagering-sqs:4566)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_HOST_PORT=4566
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wagering-events.fifo
SQS_CONSUMER_NAME=wager-transactions-consumer
SQS_MAX_RECEIVES=5
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_WAIT_TIME_SECONDS=20
SQS_BATCH_SIZE=10
# Backoff exponencial da visibilidade da mensagem em erro transitório
SQS_RETRY_BASE_DELAY_SECONDS=2
SQS_RETRY_MAX_DELAY_SECONDS=300

# Outbox
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000
OUTBOX_RETRY_BASE_DELAY_MS=1000
OUTBOX_RETRY_MAX_DELAY_MS=60000

# Reprocessamento de referências pendentes (PENDING_REFERENCE)
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
PENDING_REFERENCE_BATCH_SIZE=50
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_BASE_DELAY_MS=1000
PENDING_REFERENCE_MAX_DELAY_MS=300000
